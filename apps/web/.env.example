NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BACKEND_URL=

# Projects / Workspace UI. On by default; set to false to disable.
# NEXT_PUBLIC_FF_PROJECTS=false

# Optional override for the MCP endpoint shown on /mcp.
# Defaults to NEXT_PUBLIC_BACKEND_URL + /mcp
NEXT_PUBLIC_MCP_URL=

# Clerk Authentication (Get these from your Clerk Dashboard: https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

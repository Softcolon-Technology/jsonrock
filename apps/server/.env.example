MONGODB_URI=mongodb://localhost:27017/jsonrock
PORT=3005
NODE_ENV=development

# Public site origin used in share links returned by the MCP server and in
# project-invite emails (/workspace/invite?token=...).
# Defaults to http://localhost:3000 in development and https://jsonrock.com in production.
SITE_URL=http://localhost:3000

# Clerk Authentication (Get these from your Clerk Dashboard: https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Resend — required for share-via-email (uses published template alias "document-share")
# and project invite emails (inline HTML; if unset, invites are still created and a warning is logged)
RESEND_API_KEY=re_...
# From address must use a verified Resend domain (e.g. jsonrock.com)
RESEND_FROM_EMAIL=
